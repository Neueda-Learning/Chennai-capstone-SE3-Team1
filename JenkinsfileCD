// CI: builds the four images from THIS repository's layout and pushes them to the ECR of the AWS
// account the Jenkins machine runs in. The tag (1.<build number>) is what JenkinsfileCD deploys.
//
// The build settings are the ones docker-compose.yml passes from .env (Jenkins has no .env):
//   order/executor  context Application/Services, Dockerfile <service>/Dockerfile, libraries
//                   libs/domain-engine and libs/eventbus built first (PRE_INSTALL_DIRS)
//   frontend        Java for the OpenAPI client generator (BUILD_APK) and Application/Contracts +
//                   Application/Config handed in as the "extra" build context, copied to / (EXTRA_DEST)
// The page's backend addresses are not baked in: the frontend rewrites them when it starts.
pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
    timeout(time: 45, unit: 'MINUTES')
  }

  triggers {
    githubPush()
    pollSCM('H */2 * * *')
  }

  parameters {
    string(name: 'AWS_REGION', defaultValue: 'ap-south-1', description: 'AWS region')
  }

  environment {
    AUTH_REPO = 'etp-auth-service'
    ORDER_REPO = 'etp-order-service'
    EXECUTOR_REPO = 'etp-executor-service'
    FRONTEND_REPO = 'etp-frontend'
    AUTH_LOCAL_IMAGE = 'auth-service'
    ORDER_LOCAL_IMAGE = 'order-service'
    EXECUTOR_LOCAL_IMAGE = 'executor-service'
    FRONTEND_LOCAL_IMAGE = 'frontend'
  }

  stages {
    stage('Checkout SCM') {
      steps {
        checkout scm
        script {
          env.AWS_REGION = params.AWS_REGION?.trim() ?: 'ap-south-1'
          env.RELEASE_TAG = "1.${env.BUILD_NUMBER}"
        }
      }
    }

    stage('Validate build agent') {
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          fail() { echo "VALIDATION FAILED: $1" >&2; exit 1; }
          command -v aws >/dev/null    || fail "aws CLI is not installed for the jenkins user"
          command -v docker >/dev/null || fail "docker is not installed"
          docker info >/dev/null 2>&1  || fail "the jenkins user cannot use docker (add it to the docker group, restart Jenkins)"
          docker buildx version >/dev/null 2>&1 || fail "docker buildx is missing (needed for --build-context)"
          aws sts get-caller-identity >/dev/null || fail "no AWS credentials for the jenkins user (instance role or aws configure)"
          for f in Application/Services/auth-service/Dockerfile \
                   Application/Services/order-service/Dockerfile \
                   Application/Services/executor-service/Dockerfile \
                   Application/Frontend/frontend-app/Dockerfile; do
            test -f "$f" || fail "missing $f"
          done
          free_gb=$(df -BG --output=avail "$WORKSPACE" | tail -1 | tr -dc 0-9)
          [ "$free_gb" -ge 3 ] || fail "only ${free_gb} GB free; builds need about 3 GB (docker builder prune)"
          echo "agent OK: $(aws sts get-caller-identity --query Account --output text), ${free_gb} GB free"
        '''
      }
    }

    stage('Build and push ECR') {
      steps {
        script {
          env.AWS_ACCOUNT_ID = sh(script: 'aws sts get-caller-identity --query Account --output text', returnStdout: true).trim()
          env.REGISTRY = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
        }
        sh '''#!/usr/bin/env bash
            set -euo pipefail
            echo "== build $RELEASE_TAG"
            docker build -t "$AUTH_LOCAL_IMAGE:$RELEASE_TAG" Application/Services/auth-service

            for svc in order-service:8081:"$ORDER_LOCAL_IMAGE" executor-service:8082:"$EXECUTOR_LOCAL_IMAGE"; do
              IFS=: read -r dir port image <<< "$svc"
              docker build -f "Application/Services/$dir/Dockerfile" \
                --build-arg APP_DIR="$dir" \
                --build-arg PRE_INSTALL_DIRS="libs/domain-engine libs/eventbus" \
                --build-arg APP_PORT="$port" \
                -t "$image:$RELEASE_TAG" Application/Services
            done

            FE_EXTRA="$WORKSPACE/.fe-extra"
            rm -rf "$FE_EXTRA" && mkdir -p "$FE_EXTRA"
            cp -r Application/Contracts Application/Config "$FE_EXTRA"/
            cd Application/Frontend/frontend-app
            docker build \
            --build-arg BUILD_APK=openjdk21-jre-headless \
            --build-context extra="$FE_EXTRA" \
            --build-arg EXTRA_DEST=/ \
            -t "$FRONTEND_LOCAL_IMAGE:$RELEASE_TAG" .
            rm -rf "$FE_EXTRA"

            echo "== push to $REGISTRY"
            aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$REGISTRY"
            declare -A IMAGE_MAP=(
              ["$AUTH_REPO"]="$AUTH_LOCAL_IMAGE"
              ["$ORDER_REPO"]="$ORDER_LOCAL_IMAGE"
              ["$EXECUTOR_REPO"]="$EXECUTOR_LOCAL_IMAGE"
              ["$FRONTEND_REPO"]="$FRONTEND_LOCAL_IMAGE"
            )
            for repo in "${!IMAGE_MAP[@]}"; do
              aws ecr describe-repositories --region "$AWS_REGION" --repository-names "$repo" >/dev/null 2>&1 || \
                aws ecr create-repository --region "$AWS_REGION" --repository-name "$repo" \
                  --image-scanning-configuration scanOnPush=true \
                  --encryption-configuration encryptionType=AES256 >/dev/null
              docker tag "${IMAGE_MAP[$repo]}:$RELEASE_TAG" "$REGISTRY/$repo:$RELEASE_TAG"
              docker push "$REGISTRY/$repo:$RELEASE_TAG"
            done
            echo "CI image tag: $RELEASE_TAG"
            echo "IMAGE_TAG=$RELEASE_TAG"
        '''
      }
    }
  }

  post {
    always {
      // The local copies are in ECR now; drop them and old build cache so the disk does not fill up.
      sh '''#!/usr/bin/env bash
        [ -n "${REGISTRY:-}" ] && docker logout "$REGISTRY" || true
        for i in "$AUTH_LOCAL_IMAGE" "$ORDER_LOCAL_IMAGE" "$EXECUTOR_LOCAL_IMAGE" "$FRONTEND_LOCAL_IMAGE" \
                 "${REGISTRY:-none}/$AUTH_REPO" "${REGISTRY:-none}/$ORDER_REPO" "${REGISTRY:-none}/$EXECUTOR_REPO" "${REGISTRY:-none}/$FRONTEND_REPO"; do
          docker image rm "$i:${RELEASE_TAG:-none}" >/dev/null 2>&1 || true
        done
        docker builder prune -f --filter until=72h >/dev/null 2>&1 || true
      '''
    }
  }
}
