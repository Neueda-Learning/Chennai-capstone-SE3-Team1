<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.team1.executor.mapper.OrderMapper">

    <resultMap id="orderResultMap" type="com.team1.executor.model.OrderRow">
        <constructor>
            <arg column="order_id" javaType="java.util.UUID" typeHandler="com.team1.executor.mybatis.UuidTypeHandler"/>
            <arg column="client_id" javaType="java.lang.Long"/>
            <arg column="account_id" javaType="java.lang.Long"/>
            <arg column="instrument_id" javaType="java.lang.String"/>
            <arg column="order_type" javaType="java.lang.String"/>
            <arg column="side" javaType="java.lang.String"/>
            <arg column="quantity" javaType="java.math.BigDecimal"/>
            <arg column="price" javaType="java.math.BigDecimal"/>
            <arg column="executed_price" javaType="java.math.BigDecimal"/>
            <arg column="status" javaType="java.lang.String"/>
            <arg column="idempotency_key" javaType="java.lang.String"/>
            <arg column="external_order_id" javaType="java.lang.String"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
            <arg column="updated_at" javaType="java.time.LocalDateTime"/>
            <arg column="executed_on" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <select id="findByOrderId" resultMap="orderResultMap">
        SELECT order_id, client_id, account_id, instrument_id, order_type, side,
               quantity, price, executed_price, status, idempotency_key, external_order_id,
               created_at, updated_at, executed_on
        FROM orders
        WHERE order_id = #{orderId}
    </select>

    <update id="updateStatusAndExecutedPrice">
        UPDATE orders
        SET status = #{status},
            executed_price = #{executedPrice},
            executed_on = #{executedOn},
            updated_at = now()
        WHERE order_id = #{orderId}
          AND status = 'NEW'
    </update>

    <update id="updateStatusAndReason">
        UPDATE orders
        SET status = #{status},
            updated_at = now()
        WHERE order_id = #{orderId}
          AND status = 'NEW'
    </update>

</mapper>