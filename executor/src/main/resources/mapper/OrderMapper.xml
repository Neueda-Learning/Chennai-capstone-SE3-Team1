<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.team1.executor.mapper.OrderMapper">

    <resultMap id="orderResultMap" type="com.team1.executor.model.OrderRow">
        <id property="orderId" column="order_id"/>
        <result property="clientId" column="client_id"/>
        <result property="accountId" column="account_id"/>
        <result property="instrumentId" column="instrument_id"/>
        <result property="orderType" column="order_type"/>
        <result property="side" column="side"/>
        <result property="quantity" column="quantity"/>
        <result property="price" column="price"/>
        <result property="executedPrice" column="executed_price"/>
        <result property="status" column="status"/>
        <result property="idempotencyKey" column="idempotency_key"/>
        <result property="externalOrderId" column="external_order_id"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="executedOn" column="executed_on"/>
    </resultMap>

    <select id="findByOrderId" resultMap="orderResultMap">
        SELECT order_id, client_id, account_id, instrument_id, order_type, side,
               quantity, price, executed_price, status, idempotency_key, external_order_id,
               created_at, updated_at, executed_on
        FROM orders
        WHERE order_id = #{orderId}
    </select>

    <update id="updateStatusAndExecutedPrice">
        UPDATE orders
        SET status = #{status},
            executed_price = #{executedPrice},
            executed_on = #{executedOn},
            updated_at = now()
        WHERE order_id = #{orderId}
          AND status = 'NEW'
    </select>

    <update id="updateStatusAndReason">
        UPDATE orders
        SET status = #{status},
            updated_at = now()
        WHERE order_id = #{orderId}
          AND status = 'NEW'
    </select>

</mapper>