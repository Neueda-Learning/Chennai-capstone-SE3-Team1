pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
    timeout(time: 45, unit: 'MINUTES')
  }

  triggers {
    githubPush()
    pollSCM('H */2 * * *')
  }

  parameters {
    string(
      name: 'AWS_REGION',
      defaultValue: 'ap-south-1',
      description: 'AWS region for ECR'
    )
  }

  environment {
    AUTH_REPO     = 'etp-auth-service'
    ORDER_REPO    = 'etp-order-service'
    EXECUTOR_REPO = 'etp-executor-service'
    FRONTEND_REPO = 'etp-frontend'

    AUTH_LOCAL_IMAGE     = 'auth-service'
    ORDER_LOCAL_IMAGE    = 'order-service'
    EXECUTOR_LOCAL_IMAGE = 'executor-service'
    FRONTEND_LOCAL_IMAGE = 'frontend'
  }

  stages {
    stage('Checkout SCM') {
      steps {
        checkout scm

        script {
          env.AWS_REGION = params.AWS_REGION?.trim() ?: 'ap-south-1'
          env.RELEASE_TAG = "1.${env.BUILD_NUMBER}"

          echo "AWS region: ${env.AWS_REGION}"
          echo "Release tag: ${env.RELEASE_TAG}"
          echo "Workspace: ${env.WORKSPACE}"
        }
      }
    }

    stage('Validate build agent') {
      steps {
        sh '''#!/usr/bin/env bash
          set -Eeuo pipefail

          fail() {
            echo ""
            echo "=========================================="
            echo "VALIDATION FAILED: $1"
            echo "=========================================="
            exit 1
          }

          check() {
            echo ""
            echo "------------------------------------------"
            echo "CHECK: $1"
            echo "------------------------------------------"
          }

          check "Operating system and user"
          id || fail "Unable to identify the current user"
          uname -a || true

          check "AWS CLI installation"
          command -v aws || fail "AWS CLI is not installed or is not in PATH"
          aws --version || fail "AWS CLI could not run"

          check "Docker CLI installation"
          command -v docker || fail "Docker is not installed or is not in PATH"
          docker --version || fail "Docker CLI could not run"

          check "Docker daemon access"
          if ! docker info; then
            fail "Docker daemon is unavailable or the Jenkins user lacks permission. Check Docker service and socket permissions."
          fi

          check "Docker Buildx"
          if ! docker buildx version; then
            fail "Docker Buildx is missing or unavailable. Install/configure the Buildx plugin."
          fi

          check "AWS credentials and identity"
          if ! aws sts get-caller-identity; then
            fail "AWS credentials are unavailable or invalid. Configure an IAM role or another supported credential provider."
          fi

          check "AWS region"
          echo "AWS_REGION=$AWS_REGION"
          aws configure list || true

          check "Required Dockerfiles"
          files=(
            "Application/Services/auth-service/Dockerfile"
            "Application/Services/order-service/Dockerfile"
            "Application/Services/executor-service/Dockerfile"
            "Application/Frontend/frontend-app/Dockerfile"
          )

          for f in "${files[@]}"; do
            if [[ -f "$f" ]]; then
              echo "FOUND: $f"
            else
              echo "MISSING: $f"
              fail "Required Dockerfile not found: $f"
            fi
          done

          check "Frontend extra build-context directories"
          for d in Application/Contracts Application/Config; do
            if [[ -d "$d" ]]; then
              echo "FOUND: $d"
            else
              fail "Required frontend directory not found: $d"
            fi
          done

          check "Backend shared libraries"
          for d in libs/domain-engine libs/eventbus; do
            if [[ -d "$d" ]]; then
              echo "FOUND: $d"
            else
              fail "Required shared library directory not found: $d"
            fi
          done

          check "Available disk space"
          df -h "$WORKSPACE" || fail "Unable to check workspace disk space"

          free_gb=$(df -BG --output=avail "$WORKSPACE" | tail -n 1 | tr -dc '0-9')

          if [[ -z "$free_gb" ]]; then
            fail "Unable to determine available disk space"
          fi

          echo "Available space: ${free_gb} GB"

          if (( free_gb < 3 )); then
            fail "Only ${free_gb} GB free; at least 3 GB is required. Inspect Docker disk usage before cleaning up."
          fi

          check "Docker storage"
          docker system df || true

          check "Validation summary"
          account_id=$(aws sts get-caller-identity --query Account --output text) ||
            fail "Unable to retrieve AWS account ID"

          echo "Agent validation passed"
          echo "AWS account: $account_id"
          echo "AWS region: $AWS_REGION"
          echo "Release tag: $RELEASE_TAG"
          echo "Free disk space: ${free_gb} GB"
        '''
      }
    }

    stage('Build and push ECR') {
      steps {
        script {
          env.AWS_ACCOUNT_ID = sh(
            script: 'aws sts get-caller-identity --query Account --output text',
            returnStdout: true
          ).trim()

          env.REGISTRY =
            "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"

          echo "ECR registry: ${env.REGISTRY}"
        }

        sh '''#!/usr/bin/env bash
          set -Eeuo pipefail

          echo "=========================================="
          echo "BUILDING IMAGES"
          echo "Release tag: $RELEASE_TAG"
          echo "=========================================="

          echo ""
          echo "BUILD 1/4: Authentication service"
          docker build \
            -t "$AUTH_LOCAL_IMAGE:$RELEASE_TAG" \
            Application/Services/auth-service

          echo ""
          echo "BUILD 2/4 and 3/4: Backend services"

          for svc in \
            "order-service:8081:$ORDER_LOCAL_IMAGE" \
            "executor-service:8082:$EXECUTOR_LOCAL_IMAGE"
          do
            IFS=: read -r dir port image <<< "$svc"

            echo "Building $dir on port $port"

            docker build \
              -f "Application/Services/$dir/Dockerfile" \
              --build-arg APP_DIR="$dir" \
              --build-arg PRE_INSTALL_DIRS="libs/domain-engine libs/eventbus" \
              --build-arg APP_PORT="$port" \
              -t "$image:$RELEASE_TAG" \
              Application/Services
          done

          echo ""
          echo "BUILD 4/4: Frontend"

          FE_EXTRA="$WORKSPACE/.fe-extra"
          rm -rf "$FE_EXTRA"
          mkdir -p "$FE_EXTRA"

          cleanup_extra() {
            rm -rf "$FE_EXTRA"
          }
          trap cleanup_extra EXIT

          cp -r Application/Contracts Application/Config "$FE_EXTRA/"

          docker build \
            --build-context "extra=$FE_EXTRA" \
            --build-arg EXTRA_DEST=/ \
            --build-arg BUILD_APK=openjdk21-jre-headless \
            -t "$FRONTEND_LOCAL_IMAGE:$RELEASE_TAG" \
            Application/Frontend/frontend-app

          cleanup_extra
          trap - EXIT

          echo ""
          echo "=========================================="
          echo "BUILT IMAGES"
          echo "=========================================="

          docker image inspect \
            "$AUTH_LOCAL_IMAGE:$RELEASE_TAG" \
            "$ORDER_LOCAL_IMAGE:$RELEASE_TAG" \
            "$EXECUTOR_LOCAL_IMAGE:$RELEASE_TAG" \
            "$FRONTEND_LOCAL_IMAGE:$RELEASE_TAG" \
            --format '{{.RepoTags}}'

          echo ""
          echo "=========================================="
          echo "AUTHENTICATING TO AWS ECR"
          echo "=========================================="

          aws ecr get-login-password --region "$AWS_REGION" |
            docker login \
              --username AWS \
              --password-stdin \
              "$REGISTRY"

          declare -A IMAGE_MAP=(
            ["$AUTH_REPO"]="$AUTH_LOCAL_IMAGE"
            ["$ORDER_REPO"]="$ORDER_LOCAL_IMAGE"
            ["$EXECUTOR_REPO"]="$EXECUTOR_LOCAL_IMAGE"
            ["$FRONTEND_REPO"]="$FRONTEND_LOCAL_IMAGE"
          )

          echo ""
          echo "=========================================="
          echo "PUSHING IMAGES TO ECR"
          echo "=========================================="

          for repo in \
            "$AUTH_REPO" \
            "$ORDER_REPO" \
            "$EXECUTOR_REPO" \
            "$FRONTEND_REPO"
          do
            echo ""
            echo "Processing ECR repository: $repo"

            if aws ecr describe-repositories \
              --region "$AWS_REGION" \
              --repository-names "$repo" >/dev/null 2>&1; then

              echo "Repository already exists: $repo"

            else
              echo "Repository not found; attempting creation: $repo"

              aws ecr create-repository \
                --region "$AWS_REGION" \
                --repository-name "$repo" \
                --image-scanning-configuration scanOnPush=true \
                --encryption-configuration encryptionType=AES256
            fi

            local_image="${IMAGE_MAP[$repo]}"
            source_image="$local_image:$RELEASE_TAG"
            target_image="$REGISTRY/$repo:$RELEASE_TAG"

            echo "Tagging: $source_image -> $target_image"
            docker tag "$source_image" "$target_image"

            echo "Pushing: $target_image"
            docker push "$target_image"

            echo "Successfully pushed: $target_image"
          done

          echo ""
          echo "=========================================="
          echo "CI BUILD COMPLETED SUCCESSFULLY"
          echo "=========================================="
          echo "AWS account: $AWS_ACCOUNT_ID"
          echo "AWS region: $AWS_REGION"
          echo "Release tag: $RELEASE_TAG"
          echo "ECR registry: $REGISTRY"
          echo "IMAGE_TAG=$RELEASE_TAG"
        '''
      }
    }
  }

  post {
    always {
      echo 'Running CI cleanup...'

      sh '''#!/usr/bin/env bash
        set +e

        echo "Logging out from ECR if configured"
        if [[ -n "${REGISTRY:-}" ]]; then
          docker logout "$REGISTRY" || true
        fi

        echo "Removing images created by this build"

        for image in \
          "$AUTH_LOCAL_IMAGE" \
          "$ORDER_LOCAL_IMAGE" \
          "$EXECUTOR_LOCAL_IMAGE" \
          "$FRONTEND_LOCAL_IMAGE"
        do
          docker image rm "$image:${RELEASE_TAG:-none}" >/dev/null 2>&1 || true
        done

        if [[ -n "${REGISTRY:-}" ]]; then
          for repo in \
            "$AUTH_REPO" \
            "$ORDER_REPO" \
            "$EXECUTOR_REPO" \
            "$FRONTEND_REPO"
          do
            docker image rm \
              "$REGISTRY/$repo:${RELEASE_TAG:-none}" \
              >/dev/null 2>&1 || true
          done
        fi

        echo "Pruning builder cache older than 72 hours"
        docker builder prune -f --filter until=72h >/dev/null 2>&1 || true

        echo "Cleanup completed"
      '''
    }

    success {
      echo "CI pipeline succeeded. Release tag: ${env.RELEASE_TAG}"
    }

    failure {
      echo 'CI pipeline failed. Check the first failing CHECK, BUILD, or PUSH message above.'
    }
  }
}
