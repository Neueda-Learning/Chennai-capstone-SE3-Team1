pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
    timeout(time: 45, unit: 'MINUTES')
  }

  triggers {
    githubPush()
    pollSCM('H */2 * * *')
  }

  parameters {
    string(
      name: 'AWS_REGION',
      defaultValue: 'ap-south-1',
      description: 'AWS region for ECR'
    )

    string(
      name: 'K8S_OVERLAY',
      defaultValue: 'Application/k8s/overlays/four-lb',
      description: 'Kubernetes overlay containing urls.env'
    )
  }

  environment {
    AUTH_REPO     = 'etp-auth-service'
    ORDER_REPO    = 'etp-order-service'
    EXECUTOR_REPO = 'etp-executor-service'
    FRONTEND_REPO = 'etp-frontend'

    AUTH_LOCAL_IMAGE     = 'auth-service'
    ORDER_LOCAL_IMAGE    = 'order-service'
    EXECUTOR_LOCAL_IMAGE = 'executor-service'
    FRONTEND_LOCAL_IMAGE = 'frontend'
  }

  stages {
    stage('Checkout SCM') {
      steps {
        checkout scm

        script {
          env.AWS_REGION = params.AWS_REGION?.trim() ?: 'ap-south-1'
          env.K8S_OVERLAY = params.K8S_OVERLAY?.trim() ?: 'Application/k8s/overlays/four-lb'
          env.RELEASE_TAG = "1.${env.BUILD_NUMBER}"

          echo "AWS region: ${env.AWS_REGION}"
          echo "Kubernetes overlay: ${env.K8S_OVERLAY}"
          echo "Release tag: ${env.RELEASE_TAG}"
        }
      }
    }

    stage('Validate build agent') {
      steps {
        sh '''#!/usr/bin/env bash
          set -Eeuo pipefail

          fail() {
            echo "VALIDATION FAILED: $1" >&2
            exit 1
          }

          echo "=== Checking build tools ==="

          command -v aws >/dev/null ||
            fail "AWS CLI is not installed or is not in PATH"

          command -v docker >/dev/null ||
            fail "Docker CLI is not installed or is not in PATH"

          docker --version ||
            fail "Docker CLI could not run"

          docker info >/dev/null ||
            fail "Docker daemon is unavailable or Jenkins lacks Docker permissions"

          echo "=== Checking AWS credentials ==="

          aws sts get-caller-identity ||
            fail "AWS credentials are missing or invalid"

          echo "=== Checking Dockerfiles ==="

          for f in \
            Application/Services/auth-service/Dockerfile \
            Application/Services/order-service/Dockerfile \
            Application/Services/executor-service/Dockerfile \
            Application/Frontend/frontend-app/Dockerfile
          do
            [[ -f "$f" ]] || fail "Missing Dockerfile: $f"
            echo "FOUND: $f"
          done

          echo "=== Checking Kubernetes overlay ==="

          [[ -d "$K8S_OVERLAY" ]] ||
            fail "Overlay directory does not exist: $K8S_OVERLAY"

          [[ -f "$K8S_OVERLAY/urls.env" ]] ||
            fail "Missing URL configuration: $K8S_OVERLAY/urls.env"

          for key in AUTH_SERVICE_URL ORDER_SERVICE_URL FRONTEND_URL; do
            value=$(awk -F= -v key="$key" '
              $1 == key {
                sub(/^[^=]*=/, "")
                gsub(/\\r$/, "")
                print
                exit
              }
            ' "$K8S_OVERLAY/urls.env")

            [[ -n "$value" ]] ||
              fail "$key is missing or empty in $K8S_OVERLAY/urls.env"

            echo "FOUND: $key"
          done

          echo "=== Checking disk space ==="

          df -h "$WORKSPACE"

          free_gb=$(df -BG --output=avail "$WORKSPACE" |
            tail -n 1 | tr -dc '0-9')

          [[ -n "$free_gb" ]] ||
            fail "Unable to determine available disk space"

          (( free_gb >= 3 )) ||
            fail "Only ${free_gb} GB available; at least 3 GB is required"

          echo "Validation successful"
          echo "AWS region: $AWS_REGION"
          echo "Overlay: $K8S_OVERLAY"
          echo "Release tag: $RELEASE_TAG"
          echo "Free disk space: ${free_gb} GB"
        '''
      }
    }

    stage('Build and push ECR') {
      steps {
        script {
          env.AWS_ACCOUNT_ID = sh(
            script: 'aws sts get-caller-identity --query Account --output text',
            returnStdout: true
          ).trim()

          env.REGISTRY =
            "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"

          echo "AWS account: ${env.AWS_ACCOUNT_ID}"
          echo "ECR registry: ${env.REGISTRY}"
        }

        sh '''#!/usr/bin/env bash
          set -Eeuo pipefail

          echo "======================================"
          echo "Preparing ECR repositories"
          echo "======================================"

          # Create repositories only when AWS explicitly reports
          # that a repository does not exist.
          ERR_FILE=$(mktemp)
          trap 'rm -f "$ERR_FILE"' EXIT

          for repo in \
            "$AUTH_REPO" \
            "$ORDER_REPO" \
            "$EXECUTOR_REPO" \
            "$FRONTEND_REPO"
          do
            echo "Checking repository: $repo"

            if aws ecr describe-repositories \
              --region "$AWS_REGION" \
              --repository-names "$repo" \
              >/dev/null 2>"$ERR_FILE"; then

              echo "Repository exists: $repo"

            else
              if grep -q 'RepositoryNotFoundException' "$ERR_FILE"; then
                echo "Creating repository: $repo"

                aws ecr create-repository \
                  --region "$AWS_REGION" \
                  --repository-name "$repo" \
                  --image-scanning-configuration scanOnPush=true \
                  --encryption-configuration encryptionType=AES256

              else
                cat "$ERR_FILE" >&2
                echo "Failed to inspect ECR repository: $repo" >&2
                exit 1
              fi
            fi
          done

          echo "======================================"
          echo "Reading frontend URLs"
          echo "======================================"

          URL_FILE="$K8S_OVERLAY/urls.env"

          read_env_value() {
            local key="$1"
            local value

            value=$(awk -F= -v key="$key" '
              $1 == key {
                sub(/^[^=]*=/, "")
                gsub(/\\r$/, "")
                print
                exit
              }
            ' "$URL_FILE")

            if [[ -z "$value" ]]; then
              echo "Missing or empty $key in $URL_FILE" >&2
              exit 1
            fi

            printf '%s' "$value"
          }

          AUTH_URL=$(read_env_value AUTH_SERVICE_URL)
          ORDER_URL=$(read_env_value ORDER_SERVICE_URL)
          FRONTEND_URL=$(read_env_value FRONTEND_URL)

          # Preserves the original single BUILD_ENV build argument.
          # The frontend Dockerfile must declare ARG BUILD_ENV
          # and parse this space-separated KEY=value string.
          BUILD_ENV="AUTH_SERVICE_URL=$AUTH_URL AUTH_SERVICE_PORT=3000 ORDER_SERVICE_URL=$ORDER_URL ORDER_SERVICE_PORT=8081 FRONTEND_URL=$FRONTEND_URL FRONTEND_PORT=80"

          echo "Frontend URL configuration loaded successfully"

          echo "======================================"
          echo "Building Docker images"
          echo "======================================"

          echo "BUILD 1/4: Authentication service"

          docker build \
            -t "$AUTH_LOCAL_IMAGE:$RELEASE_TAG" \
            ./Application/Services/auth-service

          echo "BUILD 2/4: Order service"

          docker build \
            -t "$ORDER_LOCAL_IMAGE:$RELEASE_TAG" \
            ./Application/Services/order-service

          echo "BUILD 3/4: Executor service"

          docker build \
            -t "$EXECUTOR_LOCAL_IMAGE:$RELEASE_TAG" \
            ./Application/Services/executor-service

          echo "BUILD 4/4: Frontend"

          docker build \
            --build-arg "BUILD_ENV=$BUILD_ENV" \
            --build-arg BUILD_APK=openjdk17-jre-headless \
            -t "$FRONTEND_LOCAL_IMAGE:$RELEASE_TAG" \
            ./Application/Frontend/frontend-app

          echo "======================================"
          echo "Authenticating to ECR"
          echo "======================================"

          aws ecr get-login-password --region "$AWS_REGION" |
            docker login \
              --username AWS \
              --password-stdin \
              "$REGISTRY"

          echo "======================================"
          echo "Pushing images to ECR"
          echo "======================================"

          push_image() {
            local repo="$1"
            local local_image="$2"
            local source_image="$local_image:$RELEASE_TAG"
            local target_image="$REGISTRY/$repo:$RELEASE_TAG"

            echo "Tagging $source_image"
            docker tag "$source_image" "$target_image"

            echo "Pushing $target_image"
            docker push "$target_image"

            echo "Successfully pushed $target_image"
          }

          push_image "$AUTH_REPO" "$AUTH_LOCAL_IMAGE"
          push_image "$ORDER_REPO" "$ORDER_LOCAL_IMAGE"
          push_image "$EXECUTOR_REPO" "$EXECUTOR_LOCAL_IMAGE"
          push_image "$FRONTEND_REPO" "$FRONTEND_LOCAL_IMAGE"

          echo "======================================"
          echo "CI BUILD COMPLETED SUCCESSFULLY"
          echo "======================================"
          echo "AWS account: $AWS_ACCOUNT_ID"
          echo "AWS region: $AWS_REGION"
          echo "ECR registry: $REGISTRY"
          echo "IMAGE_TAG=$RELEASE_TAG"
        '''
      }
    }
  }

  post {
    always {
      echo 'Running cleanup'

      sh '''#!/usr/bin/env bash
        set +e

        if [[ -n "${REGISTRY:-}" ]]; then
          docker logout "$REGISTRY" || true
        fi

        for image in \
          "$AUTH_LOCAL_IMAGE" \
          "$ORDER_LOCAL_IMAGE" \
          "$EXECUTOR_LOCAL_IMAGE" \
          "$FRONTEND_LOCAL_IMAGE"
        do
          docker image rm "$image:${RELEASE_TAG:-none}" \
            >/dev/null 2>&1 || true
        done

        if [[ -n "${REGISTRY:-}" ]]; then
          for repo in \
            "$AUTH_REPO" \
            "$ORDER_REPO" \
            "$EXECUTOR_REPO" \
            "$FRONTEND_REPO"
          do
            docker image rm \
              "$REGISTRY/$repo:${RELEASE_TAG:-none}" \
              >/dev/null 2>&1 || true
          done
        fi

        echo "Cleanup completed"
      '''
    }

    success {
      echo "CI succeeded. Image tag: ${env.RELEASE_TAG}"
    }

    failure {
      echo 'CI failed. Check the first failing validation, build, or push command.'
    }
  }
}
