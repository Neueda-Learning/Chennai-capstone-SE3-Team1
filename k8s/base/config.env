# Non-secret settings for every app pod (ConfigMap etp-config). Secrets are in secrets.env.
#
# Service addresses come from Application/Config/services.env, copied to base/generated/services.env
# and mounted at /config/services.env (refresh the copy whenever services.env changes). The keys
# below override it for the cluster: an environment variable always beats services.env.
SERVICES_CONFIG_FILE=/config/services.env

# Kafka is the "kafka" Service in the cluster (services.env says localhost, which inside a pod
# is the pod itself). Java reads KAFKA_BOOTSTRAP_SERVERS (else KAFKA_HOST:KAFKA_PORT); the
# auth service's health check reads KAFKA_BROKER.
KAFKA_HOST=kafka
KAFKA_PORT=29092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_BROKER=kafka:29092

# auth-service (node pg): encrypt the RDS connection without checking the certificate (RDS's CA
# is not in Node's trust store). The Java services' driver tries SSL first on its own.
PGSSLMODE=no-verify

# Market-data poller: once an hour (the shared market-data key has a daily quota).
# Spring reads it as executor.poll-interval-seconds.
EXECUTOR_POLL_INTERVAL_SECONDS=3600
