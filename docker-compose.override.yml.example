# Host-local overrides for docker-compose.yml. Not read automatically under this name -
# copy it to docker-compose.override.yml (git-ignored) and docker-compose picks that up on
# every command with no extra flag. Trim what you don't need; nothing here is required for
# the stack to start, only for a memory-constrained host and for a known JWT/TrustMe secret.
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#
# TrustMe password: put it in ./.trustme-password (chmod 600), one line, no trailing
# newline expected either way. It's mounted into the containers and referenced by path
# (-Dtrustme.password-file=...) rather than passed as a plain env var, so it never shows up
# in `docker inspect` or in the JVM's "Picked up JAVA_TOOL_OPTIONS" log line. Without this
# file, trade-api and executor fail to start with "TrustMeException: No password available".
#
#   printf '%s' 'your-trustme-password' > .trustme-password
#   chmod 600 .trustme-password
#
# Heap caps: only matters on a box tight on RAM (e.g. a small shared EC2 instance running
# other services alongside this stack). Drop the whole kafka/trade-api/executor/auth-stub
# blocks below if you have room to spare.
services:
  kafka:
    environment:
      KAFKA_HEAP_OPTS: "-Xms256m -Xmx384m"
  auth-stub:
    environment:
      NODE_OPTIONS: "--max-old-space-size=64"
  trade-api:
    environment:
      # The API signs nothing itself; it verifies tokens with this secret. Use the .env
      # value (not the TrustMe vault's jwt.secret) so tokens minted by services/auth-stub,
      # or by hand, verify against a value you actually know.
      JWT_SECRET: ${JWT_SECRET}
      JAVA_TOOL_OPTIONS: "-Xmx384m -XX:MaxMetaspaceSize=128m -Dtrustme.password-file=/app/trustme.pw"
    volumes:
      - ./.trustme-password:/app/trustme.pw:ro
  executor:
    environment:
      JAVA_TOOL_OPTIONS: "-Xmx384m -XX:MaxMetaspaceSize=128m -Dtrustme.password-file=/app/trustme.pw"
    volumes:
      - ./.trustme-password:/app/trustme.pw:ro
