meta {
  name: Place Order
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: inherit
}

body:json {
  {
    "accountId": {{accountId}},
    "symbol": "RELIANCE",
    "side": "BUY",
    "quantity": 1,
    "price": 1300.00,
    "idempotencyKey": "{{$randomUUID}}"
  }
}

docs {
  BUY fills when price >= ask, SELL when price <= bid; otherwise the executor
  rejects with BUY_LIMIT_BELOW_ASK / SELL_LIMIT_ABOVE_BID.
  idempotencyKey must be unique per order; {{$randomUUID}} generates one per send.
  Symbols: RELIANCE, INFY, TCS, HDFCBANK, ICICIBANK, ITC, TATAMOTORS.
}
