# Read by scripts/apply_db.py (via scripts/db_config.py) for the local Postgres
# run-local.ps1 migrates/seeds on Windows. Real credentials still come from the TrustMe
# vault first if it has them; these are just the fallback/defaults.
PGHOST=localhost
PGPORT=5432
PGDATABASE=trading_platform
PGUSER=postgres
PGPASSWORD=postgres
# Only needed if psql isn't on PATH and isn't found under the usual
# C:\Program Files\PostgreSQL\<version>\bin - point this at psql.exe directly.
PSQL_BIN=

# Read only by infra/kafka/docker-compose.yml, on the Linux box running Kafka.
# Not used by run-local.ps1 on Windows - that script takes the Kafka host as a parameter
# (or prompts for it) and doesn't read this file at all.
KAFKA_PORT=9092

# The address Kafka hands back to a client outside this container after the initial
# bootstrap connect (its PLAINTEXT advertised listener) - in this setup, that's every
# client there is, since nothing else runs alongside Kafka anymore. Set this to the Linux
# box's own reachable private IP/hostname (the same value you'll type into run-local.ps1's
# Kafka host prompt on Windows), or every request past the first metadata fetch fails.
KAFKA_ADVERTISED_HOST=localhost
