PGHOST=localhost
PGPORT=5432
PGDATABASE=trading_platform
PGUSER=postgres
PGPASSWORD=postgres
PSQL_BIN=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trading_platform
POSTGRES_PORT=5432

# Sprint 6 - trade-api. Set a long random string for JWT_SECRET, not a guess.
# services/auth-stub signs tokens with this value. trade-api itself still verifies against
# the TrustMe vault's jwt.secret by default; to make a stub-minted token actually verify,
# add a JWT_SECRET: ${JWT_SECRET} override for trade-api in docker-compose.override.yml so
# both sides check the same secret. See services/auth-stub/README.md.
JWT_SECRET=
JWT_ISSUER=auth-service
TRADE_CURRENCY=USD
TRADE_API_PORT=8080

# services/auth-stub - issues JWTs for /login instead of minting one by hand.
AUTH_STUB_PORT=4000

# The Fauxnance API key itself is not here - it's the "Fauxnance" secret in the TrustMe
# vault (executor/src/main/resources/application.yml reads trustme.secret.Fauxnance), so
# it comes from .trustme-password decrypting the shared .TM file, not from this file.
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1

# Sprint 7 - Kafka. Host listener is what tools on this machine use;
# the internal listener (kafka:29092) is for containers on the stack network.
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# The address Kafka hands back to a client outside the compose network after the
# initial bootstrap connect (its PLAINTEXT advertised listener). Leave unset for a
# normal one-machine Docker Desktop setup. On a remote VM, set this to that VM's own
# reachable IP/hostname, or every request past the first metadata fetch fails.
KAFKA_ADVERTISED_HOST=localhost

# Sprint 7 - market-data poller inside the executor. Floor is 58s, enforced in
# code (PollingSchedule.floorSeconds); anything lower is clamped with a warning.
# 60s over one batch is 1440 requests/day against a 1500 poller budget.
POLL_INTERVAL_SECONDS=60
EXECUTOR_PORT=8083
