PGHOST=localhost
PGPORT=5432
PGDATABASE=trading_platform
PGUSER=postgres
PGPASSWORD=postgres
PSQL_BIN=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trading_platform
POSTGRES_PORT=5432

# Sprint 6 - trade-api. Set a long random string for JWT_SECRET, not a guess.
# The same value must be used by the auth service to issue tokens.
JWT_SECRET=
JWT_ISSUER=auth-service
TRADE_CURRENCY=USD
TRADE_API_PORT=8080

# Never commit a real key. Copy this file to .env (git-ignored) and put yours there.
FAUXNANCE_API_KEY=
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1

# Sprint 7 - Kafka. Host listener is what tools on this machine use;
# the internal listener (kafka:29092) is for containers on the stack network.
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Sprint 7 - market-data poller inside the executor. Floor is 58s, enforced in
# code (PollingSchedule.floorSeconds); anything lower is clamped with a warning.
# 60s over one batch is 1440 requests/day against a 1500 poller budget.
POLL_INTERVAL_SECONDS=60
EXECUTOR_PORT=8083
