# The repository's one environment file. Copy it to .env in the repository root and fill it in.
# .env is git-ignored; only this example is tracked. Never put real credentials in this file.
#
# How secrets are resolved, everywhere (Trade API, executor, auth service, auth stub, Python
# scripts and ETL): the TrustMe vault (leapcapstoneteam1-720d03.TM) first, then the environment
# variable named below, then this .env. A variable already set in the real environment always wins
# over .env. The vault is opened only when its key file exists and a password is supplied (or, for
# the Java and Node services, this machine already remembers the key); nothing ever stops to ask
# for a password, so without the vault everything starts from these values.
# Values are KEY=value with no spaces around "="; quote a value with "..." to use \n line breaks.

# ---------------------------------------------------------------- TrustMe vault (optional)
# Leave these empty to use the key file at the repository root and the password run-local.ps1
# asks for. A password stored here sits on disk in plain text; prefer typing it.
TRUSTME_KEY_FILE=
TRUSTME_PASSWORD=
TRUSTME_PASSWORD_FILE=

# ---------------------------------------------------------------- Fallbacks for vault secrets
# Database. Vault: PostGres_Host, Postgres_Port, Postgres_DB, PostGres_User, PostGres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Signs and verifies every JWT; the auth service, Trade API and executor must agree on it.
# At least 32 characters. Vault: JWT_SECRET.
JWT_SECRET=change-me-to-a-random-value-of-at-least-32-characters

# Market data. Vault: Fauxnance, Fauxnance_Endpoint.
FAUXNANCE_API_KEY=
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1

# RSA private key (PKCS#8 PEM) that opens encrypted login and registration bodies, on one line
# inside double quotes with \n for line breaks. Optional: without it the auth service makes a
# temporary key at startup. Vault: AUTH_PRIVATE_KEY.
AUTH_PRIVATE_KEY=

# ---------------------------------------------------------------- Not secret
# Kafka as seen from this machine. run-local.ps1 sets both for the processes it starts.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_BROKER=localhost:29092

# Only needed if psql isn't on PATH and isn't under C:\Program Files\PostgreSQL\<version>\bin.
PSQL_BIN=

# Read by Application/Infrastructure/Kafka (up.sh and docker-compose.yml) on the box running Kafka.
# up.sh replaces KAFKA_ADVERTISED_HOST=localhost with the box's own private IP on first run.
# KAFKA_PORT is the one port Kafka listens on, publishes and advertises. Normally leave it: run
# "bash Application/Infrastructure/Kafka/up.sh --port 9092" to change it (up.sh saves the choice
# here). run-local.ps1 tries 29092 and then 9092 by itself; for any other port pass -KafkaPort.
KAFKA_PORT=29092
KAFKA_ADVERTISED_HOST=localhost

# Docker Compose (infra/postgres): host ports for the containers.
TRADE_API_PORT=8080
AUTH_PORT=3000

# ---------------------------------------------------------------- Frontend end-to-end tests
# Read by Application/Frontend/frontend-app/playwright.config.ts.
BASE_URL=http://localhost:4200
AUTH_API_BASE=http://localhost:3000
TRADE_API_BASE=http://localhost:8081
TEST_USERNAME=
TEST_PASSWORD=
