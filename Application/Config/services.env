# Where every service lives: the ONE place hosts, ports and URLs are written down.
#
# Code, scripts, Dockerfiles and compose files never repeat these values; they read them from
# here (see README.md in this folder for how each part does it). Nothing in this file is secret.
# Passwords, keys and tokens stay in the TrustMe vault or the git-ignored .env at the repo root.
#
# A value can be overridden without editing this file: a real environment variable wins, then
# the repo-root .env, then this file. KEY=value, no spaces around "=", no quotes, no ${} references
# (a URL is built from its HOST and PORT where it is used).
#
# scripts/check_config.py (run by the test suite) fails if a port or URL below is written out
# anywhere else in the code.

# ---------------------------------------------------------------- Frontend (Angular)
FRONTEND_HOST=localhost
FRONTEND_PORT=4200

# ---------------------------------------------------------------- Auth service (NestJS)
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=3000

# ---------------------------------------------------------------- Auth stub (legacy stand-in)
AUTH_STUB_HOST=localhost
AUTH_STUB_PORT=4000

# ---------------------------------------------------------------- Trade API (order-service)
TRADE_API_HOST=localhost
TRADE_API_PORT=8081
# The port the same service listens on inside its Docker image (the compose file publishes
# TRADE_API_PORT on the host and maps it to this).
TRADE_API_CONTAINER_PORT=8080

# ---------------------------------------------------------------- Trade executor
EXECUTOR_HOST=localhost
EXECUTOR_PORT=8082

# ---------------------------------------------------------------- PostgreSQL
# Defaults only: the TrustMe vault (PostGres_Host / Postgres_Port) or POSTGRES_HOST / POSTGRES_PORT
# in the environment or .env take precedence.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# The port the postgres image listens on inside its container (compose publishes POSTGRES_PORT on
# the host and maps it to this; the other containers reach the database on it).
POSTGRES_CONTAINER_PORT=5432

# ---------------------------------------------------------------- Kafka
# KAFKA_PORT is the PLAINTEXT port clients connect to. run-local.ps1 tries it first and then
# KAFKA_LEGACY_PORT. "bash Application/Infrastructure/Kafka/up.sh --port N" overrides KAFKA_PORT
# for that box by saving KAFKA_PORT=N in the repo-root .env.
KAFKA_HOST=localhost
KAFKA_PORT=29092
KAFKA_LEGACY_PORT=9092
# Listeners that only exist inside the Kafka container's own network.
KAFKA_INTERNAL_PORT=19092
KAFKA_CONTROLLER_PORT=29093
# The Kafka distribution run-local.ps1 downloads for the CLI tools / a local broker.
KAFKA_VERSION=3.8.0
KAFKA_DOWNLOAD_BASE_URL=https://archive.apache.org/dist/kafka

# ---------------------------------------------------------------- External services
# Market-data API (the TrustMe secret Fauxnance_Endpoint, when present, overrides this).
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1
# AWS instance metadata, used by up.sh to find the box's own private address.
INSTANCE_METADATA_URL=http://169.254.169.254/latest/meta-data/local-ipv4
