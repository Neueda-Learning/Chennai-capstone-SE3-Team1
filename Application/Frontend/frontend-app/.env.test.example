# Copy to `.env.test` (git-ignored) and edit if your machine differs. Every value here is
# also the default in `playwright.config.ts` / `e2e/test-user.ts`, so the file is optional.

# Where the Angular dev server is. `playwright.config.ts` starts one itself if nothing is up.
BASE_URL=http://localhost:4200

# The services `.\run-local.ps1` brings up from the repo root. Only used to read the API
# directly, to check what the screens show against what the backend actually holds.
AUTH_API_BASE=http://localhost:3000
TRADE_API_BASE=http://localhost:8081

# An account that already exists in the local database. Registration is not exercised: it
# ends in an email OTP, so an end-to-end run cannot get past it.
TEST_USERNAME=nadellaroshni2
TEST_PASSWORD=Roshni@22036