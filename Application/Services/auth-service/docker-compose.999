# A Kafka for running the auth service on its own. Every host and port comes from
# Application/Config/services.env; start it with
#   docker compose --env-file ../../Config/services.env up -d
version: '3.8'

services:
  kafka:
    image: apache/kafka:3.7.0
    container_name: team1-kafka
    environment:
      - KAFKA_PROCESS_ROLES=broker,controller
      - KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:${KAFKA_CONTROLLER_PORT:?set it in Application/Config/services.env}
      - KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:${KAFKA_PORT:?set it in Application/Config/services.env},CONTROLLER://0.0.0.0:${KAFKA_CONTROLLER_PORT:?set it in Application/Config/services.env}
      - KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://${KAFKA_HOST:?set it in Application/Config/services.env}:${KAFKA_PORT:?set it in Application/Config/services.env}
      - KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
      - KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
      - KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
      - KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
      - KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
      - KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
      - KAFKA_LOG_DIRS=/var/lib/kafka/data
      - KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
      - KAFKA_NUM_PARTITIONS=3
      - KAFKA_LOG_RETENTION_HOURS=168
      - KAFKA_LOG_SEGMENT_BYTES=1073741824
      - KAFKA_LOG_RETENTION_CHECK_INTERVAL_MS=300000
      - CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
    ports:
      - "${KAFKA_PORT:?set it in Application/Config/services.env}:${KAFKA_PORT:?set it in Application/Config/services.env}"
      - "${KAFKA_CONTROLLER_PORT:?set it in Application/Config/services.env}:${KAFKA_CONTROLLER_PORT:?set it in Application/Config/services.env}"
    volumes:
      - kafka_data:/var/lib/kafka/data
    healthcheck:
      test: ["CMD-SHELL", "kafka-broker-api-versions --bootstrap-server localhost:${KAFKA_PORT:?set it in Application/Config/services.env}"]
      interval: 10s
      timeout: 10s
      retries: 5

volumes:
  kafka_data: