# Template for k8s/base/secrets.env (git-ignored). Copy it, then fill in the values:
#   cp k8s/base/secrets.env.example k8s/base/secrets.env
# Names are the ones the application code reads (the fallback names of the TrustMe secrets).
# One KEY=value per line, no quotes. AUTH_PRIVATE_KEY stays on one line with \n for line breaks.

# PostgreSQL (RDS)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=trading_platform
POSTGRES_USER=
POSTGRES_PASSWORD=

# JWT signing secret, shared by auth, order and executor (32+ characters)
JWT_SECRET=

# Market-data API key
FAUXNANCE_API_KEY=

# RSA private key (PKCS#8 PEM) for encrypted login/registration bodies
AUTH_PRIVATE_KEY=

# Gemini key for the assistant chatbot
LLM_API_KEY=

# Mail server for OTP codes and EMAIL notifications
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
